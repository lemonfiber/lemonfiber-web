{
  "name": "@lemonfiber/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The lemonfiber web surface: a static app drawn from the JSON API the binary serves.",
  "license": "SEE LICENSE IN LICENSE",
  "repository": { "type": "git", "url": "https://github.com/lemonfiber/lemonfiber-web.git" },
  "engines": { "node": ">=26" },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",

    "types": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "arch": "depcruise src --config .dependency-cruiser.cjs",
    "guard": "node scripts/guards.mjs",

    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "e2e": "playwright test",

    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",

    "ci": "npm run format:check && npm run lint && npm run types && npm run guard && npm run arch && npm run coverage && npm run build"
  },
  "dependencies": {
    "@lemonfiber/brand": "github:lemonfiber/brand#ec9e063a51b4423e9148538f3226601e40967423"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@storybook/addon-a11y": "^10.5.10",
    "@storybook/svelte-vite": "^10.5.10",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/svelte": "^5.4.2",
    "@testing-library/user-event": "^14.6.6",
    "@vitest/coverage-v8": "^4.1.11",
    "dependency-cruiser": "^18.2.0",
    "eslint": "^10.9.0",
    "eslint-plugin-svelte": "^3.23.0",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^4.1.1",
    "storybook": "^10.5.10",
    "svelte": "^5.56.10",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
